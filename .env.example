# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=canopus_labs

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────────────────────────────
# Frontend origin (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# ─── Frontend API URL ────────────────────────────────────────────────────────
# Leave empty to use the Vite proxy in development (points to localhost:3001)
# Set to your deployed backend URL for production builds
VITE_API_URL=https://canopus-labs-api.onrender.com
